# Optional Compose overrides. The release compose.yaml works without .env.
# CLIP_IMAGE=ghcr.io/owner/lan-clipboard:v1.1.0
CLIP_BIND_ADDRESS=127.0.0.1
CLIP_HOST_PORT=18080
# Set this when users access the app via a custom hostname or HTTPS proxy.
# CLIP_PUBLIC_ORIGIN=https://clip.example.test
# Only used with compose.bind.yaml. The local directory must already exist.
# CLIP_HOST_DATA_DIR=/volume1/docker/lan-clipboard/data
TZ=Asia/Shanghai

# Existing application defaults; retention still runs daily at 03:00 in TZ.
CLIP_MAX_FILE_SIZE=300
CLIP_MAX_TEXT_SIZE=307200
CLIP_RETENTION_DAYS=30
CLIP_THUMBNAIL_THRESHOLD=10

# Set both values to enable DOCX/PPTX previews in Docker Compose.
# COMPOSE_PROFILES=office
# CLIP_OFFICE_CONVERTER_URL=http://office:3000
